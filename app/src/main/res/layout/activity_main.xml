<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginVertical="36dp"
    android:layout_marginHorizontal="24dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/mainHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"

        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <com.google.android.material.imageview.ShapeableImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            app:srcCompat="@drawable/logo_coffe_1"
            />
        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="WARKOP GUNDAR"
            android:textSize="14sp"
            android:letterSpacing="0.4"
            android:textStyle="normal"/>
    </LinearLayout>

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/mainImage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"

        app:layout_constraintTop_toBottomOf="@id/mainHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:srcCompat="@drawable/logo_coffe_2"/>

    <LinearLayout
        android:id="@+id/mainTitleContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="40dp"
        android:orientation="vertical"
        android:gravity="center"

        app:layout_constraintTop_toBottomOf="@id/mainImage"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Find Your Favorite"
            android:textSize="24sp"
            />

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Coffe Taste!"
            android:textSize="30sp"
            android:textStyle="bold"/>

        <com.google.android.material.textview.MaterialTextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="We’re coffee shop, beer and wine bar, \n&amp; event space for performing arts"
            android:textSize="14sp"
            android:textStyle="normal"
            android:textColor="@color/gray"
            android:textAlignment="center"
            />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/actionStarted"
        style="@style/Widget.Material3.Button"
        android:layout_width="wrap_content"
        android:layout_height="60dp"
        android:layout_marginTop="29dp"
        android:backgroundTint="@color/primary"
        android:paddingStart="32dp"
        android:paddingEnd="4dp"
        android:text="Get Started"
        android:textAllCaps="false"
        android:textColor="@color/white"
        android:textSize="18sp"
        android:textStyle="bold"

        app:layout_constraintTop_toBottomOf="@id/mainTitleContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"

        app:cornerRadius="32dp"
        app:icon="@drawable/com_arrow_with_circle"
        app:iconGravity="textEnd"
        app:iconSize="44dp"

        app:iconTint="@null"
        app:iconPadding="16dp" />

</androidx.constraintlayout.widget.ConstraintLayout>