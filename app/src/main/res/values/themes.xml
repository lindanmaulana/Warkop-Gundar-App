<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Base.Theme.WarkopGundar" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Customize your light theme here. -->
        <!-- <item name="colorPrimary">@color/my_light_primary</item> -->
        <item name="android:windowBackground">@color/white</item>
        <item name="android:colorBackground">@color/white</item>
        <item name="fontFamily">@font/poppins_regular</item>
        <item name="textFillColor">@color/primary</item>
    </style>

    <style name="Theme.WarkopGundar" parent="Base.Theme.WarkopGundar" />

    <style name="RoundedSquare" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">14dp</item>
    </style>

    <style name="RoundedImageCard" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSize">20dp</item>
    </style>

    <style name="RoundedHorizontal1" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSizeTopLeft">60dp</item>
        <item name="cornerSizeTopRight">60dp</item>

        <item name="cornerSizeBottomLeft">60dp</item>
        <item name="cornerSizeBottomRight">60dp</item>
    </style>

    <style name="TopRoundedCornerCard1" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSizeTopLeft">60dp</item>
        <item name="cornerSizeTopRight">60dp</item>

        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="TopRoundedCornerCard2" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSizeTopLeft">60dp</item>
        <item name="cornerSizeTopRight">60dp</item>

        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="TopRoundedCornerCard3" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSizeTopLeft">20dp</item>
        <item name="cornerSizeTopRight">20dp</item>

        <item name="cornerSizeBottomLeft">0dp</item>
        <item name="cornerSizeBottomRight">0dp</item>
    </style>

    <style name="BottomRoundedCornerCard" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerSizeTopLeft">0dp</item>
        <item name="cornerSizeTopRight">0dp</item>
        <item name="cornerSizeBottomLeft">50dp</item>
        <item name="cornerSizeBottomRight">50dp</item>
    </style>
</resources>