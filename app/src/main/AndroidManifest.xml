<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.WarkopGundar"
        tools:replace="android:allowBackup">
        <activity
            android:name=".features.dashboard.fragments.settings.SettingProfileActivity"
            android:exported="false" />
        <activity
            android:name=".features.order.OrderPaymentStatusActivity"
            android:exported="false" />
        <activity
            android:name=".features.order.OrderPaymentActivity"
            android:exported="false" />
        <activity
            android:name=".features.dashboard.fragments.settings.SettingContactActivity"
            android:exported="false" />
        <activity
            android:name=".features.order.OrderCheckoutActivity"
            android:exported="false" />
        <activity
            android:name=".features.dashboard.fragments.menus.MenuDetailActivity"
            android:exported="false" />
        <activity
            android:name=".features.dashboard.DashboardActivity"
            android:exported="false" />
        <activity
            android:name=".features.auth.AuthSignupActivity"
            android:exported="false" />
        <activity
            android:name=".features.auth.AuthSigninActivity"
            android:exported="false" />
        <activity
            android:name=".features.onboarding.OnboardingActivity"
            android:exported="false" />
        <activity
            android:name=".MainActivity"
            android:exported="false" />
        <activity
            android:name=".SplashScreenActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>